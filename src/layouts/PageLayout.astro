---
// The shell every page uses: <head>, the site header and footer.
// MDX pages wrap their content in <PageLayout title="…" description="…">.
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  /** For pages that are one big map or story: no page padding, no footer. */
  bleed?: boolean;
};

const { title, description, bleed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body class:list={{ bleed }}>
    <Header />
    <main>
      <slot />
    </main>
    {!bleed && <Footer />}
  </body>
</html>
